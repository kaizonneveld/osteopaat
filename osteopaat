<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OsteoSearch — Model van 5 Analyser</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F7F4EF;
    --warm-white: #FDFCFA;
    --ink: #1A1714;
    --ink-soft: #4A4540;
    --ink-muted: #8A837A;
    --line: rgba(26,23,20,0.1);
    --line-soft: rgba(26,23,20,0.06);
    --sage: #6B8C7A;
    --sage-light: #EDF2EE;
    --sage-dark: #3D5447;
    --amber-soft: #C4895A;
    --amber-light: #FAF0E6;
    --rust: #8B4A2B;
    --rust-light: #F5EBE4;
    --blue-calm: #4A6B8A;
    --blue-light: #E8EFF5;
    --plum: #6B4A72;
    --plum-light: #F0EBF2;
    --radius: 16px;
    --radius-sm: 8px;
    --radius-pill: 100px;
    --shadow: 0 2px 24px rgba(26,23,20,0.06);
    --shadow-hover: 0 4px 32px rgba(26,23,20,0.1);
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--ink);
    min-height: 100vh;
    line-height: 1.6;
  }

  .page-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HEADER */
  header {
    padding: 48px 0 40px;
    text-align: center;
    position: relative;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .logo-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .logo-circle::before {
    content: '';
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    opacity: 0.4;
  }

  .logo-circle::after {
    content: '';
    position: absolute;
    width: 1px;
    height: 28px;
    background: var(--ink);
    opacity: 0.3;
    transform: rotate(45deg);
  }

  .logo-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 12px;
  }

  h1 em {
    font-style: italic;
    color: var(--ink-soft);
  }

  .subtitle {
    font-size: 15px;
    color: var(--ink-muted);
    font-weight: 300;
    letter-spacing: 0.01em;
  }

  /* DIVIDER */
  .divider {
    width: 48px;
    height: 1px;
    background: var(--ink);
    opacity: 0.15;
    margin: 28px auto;
  }

  /* SEARCH */
  .search-section {
    margin-bottom: 48px;
  }

  .search-box {
    background: var(--warm-white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 8px 8px 8px 20px;
    display: flex;
    align-items: flex-end;
    gap: 12px;
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s;
  }

  .search-box:focus-within {
    box-shadow: var(--shadow-hover);
    border-color: rgba(26,23,20,0.2);
  }

  .search-box textarea {
    flex: 1;
    border: none;
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: var(--ink);
    resize: none;
    outline: none;
    line-height: 1.6;
    padding: 10px 0;
    min-height: 52px;
    max-height: 160px;
  }

  .search-box textarea::placeholder {
    color: var(--ink-muted);
  }

  .search-btn {
    flex-shrink: 0;
    background: var(--ink);
    color: var(--warm-white);
    border: none;
    border-radius: 10px;
    padding: 12px 22px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    align-self: flex-end;
    margin-bottom: 2px;
  }

  .search-btn:hover { background: #2E2A27; }
  .search-btn:active { transform: scale(0.98); }
  .search-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .search-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hint {
    font-size: 12px;
    color: var(--ink-muted);
    text-align: center;
    margin-top: 12px;
  }

  /* STATE: LOADING */
  .loading-state {
    text-align: center;
    padding: 64px 0;
    display: none;
  }

  .pulse-ring {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    animation: pulse 1.8s ease-in-out infinite;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-ring::before {
    content: '';
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--ink-soft);
    animation: pulse 1.8s ease-in-out 0.3s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.95); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .loading-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    color: var(--ink-soft);
    font-style: italic;
  }

  /* RESULTS */
  .results-section {
    display: none;
  }

  .results-header {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .query-display {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }

  .results-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.2;
  }

  /* MODEL CARDS GRID */
  .models-grid {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
  }

  .model-card {
    background: var(--warm-white);
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .model-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .model-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .model-icon svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
    margin-bottom: 2px;
  }

  .card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
  }

  .card-body {
    padding: 16px 20px 20px;
    display: grid;
    gap: 14px;
  }

  .section-block {
    display: grid;
    gap: 6px;
  }

  .section-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .section-text {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .tag {
    font-size: 12px;
    font-weight: 400;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  /* Per model colors */
  .model-bio .model-icon { background: var(--sage-light); color: var(--sage-dark); }
  .model-bio .card-label { color: var(--sage); }
  .model-bio .card-header { border-bottom-color: rgba(107,140,122,0.12); }
  .model-bio .tag { background: var(--sage-light); border-color: rgba(107,140,122,0.3); color: var(--sage-dark); }

  .model-neuro .model-icon { background: var(--blue-light); color: var(--blue-calm); }
  .model-neuro .card-label { color: var(--blue-calm); }
  .model-neuro .card-header { border-bottom-color: rgba(74,107,138,0.12); }
  .model-neuro .tag { background: var(--blue-light); border-color: rgba(74,107,138,0.3); color: var(--blue-calm); }

  .model-resp .model-icon { background: var(--amber-light); color: var(--amber-soft); }
  .model-resp .card-label { color: var(--amber-soft); }
  .model-resp .card-header { border-bottom-color: rgba(196,137,90,0.12); }
  .model-resp .tag { background: var(--amber-light); border-color: rgba(196,137,90,0.3); color: var(--rust); }

  .model-meta .model-icon { background: var(--rust-light); color: var(--rust); }
  .model-meta .card-label { color: var(--rust); }
  .model-meta .card-header { border-bottom-color: rgba(139,74,43,0.12); }
  .model-meta .tag { background: var(--rust-light); border-color: rgba(139,74,43,0.3); color: var(--rust); }

  .model-psych .model-icon { background: var(--plum-light); color: var(--plum); }
  .model-psych .card-label { color: var(--plum); }
  .model-psych .card-header { border-bottom-color: rgba(107,74,114,0.12); }
  .model-psych .tag { background: var(--plum-light); border-color: rgba(107,74,114,0.3); color: var(--plum); }

  /* SUMMARY BAR */
  .summary-card {
    background: var(--ink);
    border-radius: var(--radius);
    padding: 24px 28px;
    color: var(--cream);
    margin-bottom: 32px;
  }

  .summary-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 400;
    margin-bottom: 10px;
    letter-spacing: 0.01em;
  }

  .summary-card p {
    font-size: 14px;
    color: rgba(247,244,239,0.7);
    line-height: 1.7;
  }

  /* NEW SEARCH */
  .new-search-row {
    text-align: center;
    padding: 8px 0 48px;
  }

  .new-search-btn {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 10px 22px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: var(--ink-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .new-search-btn:hover {
    border-color: rgba(26,23,20,0.25);
    color: var(--ink);
    background: var(--warm-white);
  }

  /* API KEY SECTION */
  .api-section {
    background: var(--warm-white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 24px;
    margin-bottom: 28px;
  }

  .api-section label {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-muted);
    display: block;
    margin-bottom: 8px;
  }

  .api-row {
    display: flex;
    gap: 10px;
  }

  .api-section input {
    flex: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: var(--ink);
    background: var(--cream);
    outline: none;
    font-family: monospace;
    letter-spacing: 0.04em;
  }

  .api-section input:focus {
    border-color: rgba(26,23,20,0.25);
  }

  .api-save-btn {
    background: var(--ink);
    color: var(--cream);
    border: none;
    border-radius: var(--radius-sm);
    padding: 10px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .api-save-btn:hover { background: #2E2A27; }

  .api-hint {
    font-size: 12px;
    color: var(--ink-muted);
    margin-top: 8px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ccc;
    display: inline-block;
    margin-right: 6px;
    vertical-align: middle;
  }

  .status-dot.active { background: var(--sage); }

  /* ERROR */
  .error-box {
    background: #FFF5F5;
    border: 1px solid rgba(180,60,60,0.2);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    font-size: 14px;
    color: #8B3030;
    display: none;
    margin-top: 12px;
  }

  /* FOOTER */
  footer {
    border-top: 1px solid var(--line);
    padding: 20px 0 32px;
    text-align: center;
    font-size: 12px;
    color: var(--ink-muted);
  }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .model-card {
    animation: fadeUp 0.4s ease both;
  }

  .model-card:nth-child(1) { animation-delay: 0.05s; }
  .model-card:nth-child(2) { animation-delay: 0.1s; }
  .model-card:nth-child(3) { animation-delay: 0.15s; }
  .model-card:nth-child(4) { animation-delay: 0.2s; }
  .model-card:nth-child(5) { animation-delay: 0.25s; }
</style>
</head>
<body>

<div class="page-wrap">

  <header>
    <div class="logo-mark">
      <div class="logo-circle"></div>
      <span class="logo-text">OsteoSearch</span>
    </div>
    <h1>De klacht als<br><em>systeem</em></h1>
    <p class="subtitle">Analyse via het Model van 5 — voor de osteopaat die systemisch denkt</p>
    <div class="divider"></div>
  </header>

  <!-- API KEY -->
  <div class="api-section" id="apiSection">
    <label><span class="status-dot" id="statusDot"></span>Anthropic API Sleutel</label>
    <div class="api-row">
      <input type="password" id="apiKeyInput" placeholder="sk-ant-..." autocomplete="off" />
      <button class="api-save-btn" onclick="saveApiKey()">Opslaan</button>
    </div>
    <p class="api-hint">Jouw sleutel wordt alleen lokaal opgeslagen in de browser. Haal een API key op via <a href="https://console.anthropic.com" target="_blank" style="color: var(--ink-soft);">console.anthropic.com</a></p>
  </div>

  <!-- SEARCH -->
  <div class="search-section">
    <div class="search-box">
      <textarea
        id="queryInput"
        placeholder="Beschrijf het klachtenbeeld… bijv. 'Patiënt 42j, chronische lage rugpijn links uitstralend naar het been, zit veel op werk, slaapt slecht, verhoogde stressbeleving'"
        rows="2"
        onkeydown="handleKey(event)"
        oninput="autoGrow(this)"
      ></textarea>
      <button class="search-btn" id="searchBtn" onclick="runSearch()">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Analyseer
      </button>
    </div>
    <p class="hint">Voer een klachtenbeeld in en druk op Analyseer of gebruik Enter</p>
    <div class="error-box" id="errorBox"></div>
  </div>

  <!-- LOADING -->
  <div class="loading-state" id="loadingState">
    <div class="pulse-ring"></div>
    <p class="loading-text">Systemisch analyseren…</p>
  </div>

  <!-- RESULTS -->
  <div class="results-section" id="resultsSection">
    <div class="results-header">
      <p class="query-display">Klachtenbeeld</p>
      <h2 class="results-title" id="queryDisplay"></h2>
    </div>

    <div class="summary-card" id="summaryCard">
      <h3>Osteopathische samenvatting</h3>
      <p id="summaryText"></p>
    </div>

    <div class="models-grid" id="modelsGrid"></div>

    <div class="new-search-row">
      <button class="new-search-btn" onclick="resetSearch()">↩ Nieuw klachtenbeeld invoeren</button>
    </div>
  </div>

  <footer>
    OsteoSearch · Model van 5 · Ter ondersteuning van klinische redenering · Geen vervanging voor diagnostisch onderzoek
  </footer>

</div>

<script>
const MODELS = [
  {
    key: 'biomechanisch',
    cls: 'model-bio',
    label: 'Model 1',
    title: 'Biomechanisch model',
    icon: `<svg viewBox="0 0 24 24"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`
  },
  {
    key: 'neurologisch',
    cls: 'model-neuro',
    label: 'Model 2',
    title: 'Neurologisch model',
    icon: `<svg viewBox="0 0 24 24"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-1.14M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24A2.5 2.5 0 0 0 14.5 2z"/></svg>`
  },
  {
    key: 'respiratoir',
    cls: 'model-resp',
    label: 'Model 3',
    title: 'Respiratoir-circulatoir model',
    icon: `<svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`
  },
  {
    key: 'metabool',
    cls: 'model-meta',
    label: 'Model 4',
    title: 'Metabool-energetisch model',
    icon: `<svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`
  },
  {
    key: 'biopsychosociaal',
    cls: 'model-psych',
    label: 'Model 5',
    title: 'Gedrags- / biopsychosociaal model',
    icon: `<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`
  }
];

let apiKey = localStorage.getItem('osteo_api_key') || '';
updateStatusDot();

function updateStatusDot() {
  const dot = document.getElementById('statusDot');
  if (apiKey && apiKey.startsWith('sk-')) {
    dot.classList.add('active');
  } else {
    dot.classList.remove('active');
  }
  if (apiKey) {
    document.getElementById('apiKeyInput').value = apiKey;
  }
}

function saveApiKey() {
  const val = document.getElementById('apiKeyInput').value.trim();
  if (val) {
    apiKey = val;
    localStorage.setItem('osteo_api_key', val);
    updateStatusDot();
  }
}

function autoGrow(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 160) + 'px';
}

function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    runSearch();
  }
}

function showError(msg) {
  const box = document.getElementById('errorBox');
  box.textContent = msg;
  box.style.display = 'block';
}

function hideError() {
  document.getElementById('errorBox').style.display = 'none';
}

async function runSearch() {
  const query = document.getElementById('queryInput').value.trim();
  if (!query) return;

  if (!apiKey || !apiKey.startsWith('sk-')) {
    showError('Vul eerst een geldige Anthropic API sleutel in (begint met sk-ant-).');
    return;
  }

  hideError();
  document.getElementById('searchBtn').disabled = true;
  document.getElementById('loadingState').style.display = 'block';
  document.getElementById('resultsSection').style.display = 'none';

  const systemPrompt = `Je bent een ervaren osteopaat met diepgaande kennis van het Model van 5. Je analyseert klachtenbeelden systemisch en geeft per model een gefundeerde osteopathische analyse.

Voor elk van de 5 modellen geef je:
1. Mogelijke oorzaken van de klacht vanuit dit model
2. Op welke structuren/aspecten de osteopaat extra aandacht moet richten tijdens onderzoek
3. Relevante anatomische structuren of gebieden (als tags/trefwoorden)

Reageer UITSLUITEND in geldig JSON, zonder enige toelichting of markdown buiten de JSON.
De structuur is exact:
{
  "samenvatting": "2-3 zinnen osteopathisch perspectief op het klachtenbeeld",
  "modellen": {
    "biomechanisch": {
      "oorzaken": "2-3 zinnen over mogelijke biomechanische oorzaken",
      "aandachtspunten": "2-3 zinnen over wat te onderzoeken",
      "structuren": ["tag1", "tag2", "tag3", "tag4"]
    },
    "neurologisch": {
      "oorzaken": "...",
      "aandachtspunten": "...",
      "structuren": ["tag1", "tag2", "tag3"]
    },
    "respiratoir": {
      "oorzaken": "...",
      "aandachtspunten": "...",
      "structuren": ["tag1", "tag2", "tag3"]
    },
    "metabool": {
      "oorzaken": "...",
      "aandachtspunten": "...",
      "structuren": ["tag1", "tag2", "tag3"]
    },
    "biopsychosociaal": {
      "oorzaken": "...",
      "aandachtspunten": "...",
      "structuren": ["tag1", "tag2", "tag3"]
    }
  }
}`;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1800,
        system: systemPrompt,
        messages: [
          { role: 'user', content: `Analyseer dit klachtenbeeld via het Model van 5:\n\n${query}` }
        ]
      })
    });

    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err.error?.message || `API fout: ${response.status}`);
    }

    const data = await response.json();
    const text = data.content?.[0]?.text || '';

    let parsed;
    try {
      const clean = text.replace(/```json|```/g, '').trim();
      parsed = JSON.parse(clean);
    } catch {
      throw new Error('Kon het antwoord niet verwerken. Probeer opnieuw.');
    }

    renderResults(query, parsed);

  } catch (err) {
    showError(err.message || 'Er is iets misgegaan. Controleer je API sleutel.');
  } finally {
    document.getElementById('searchBtn').disabled = false;
    document.getElementById('loadingState').style.display = 'none';
  }
}

function renderResults(query, data) {
  document.getElementById('queryDisplay').textContent = query.length > 80 ? query.slice(0, 80) + '…' : query;
  document.getElementById('summaryText').textContent = data.samenvatting || '';

  const grid = document.getElementById('modelsGrid');
  grid.innerHTML = '';

  const modelKeys = ['biomechanisch', 'neurologisch', 'respiratoir', 'metabool', 'biopsychosociaal'];

  MODELS.forEach((m, i) => {
    const d = data.modellen?.[m.key] || {};
    const card = document.createElement('div');
    card.className = `model-card ${m.cls}`;

    const tagsHtml = (d.structuren || []).map(t =>
      `<span class="tag">${t}</span>`
    ).join('');

    card.innerHTML = `
      <div class="card-header">
        <div class="model-icon">${m.icon}</div>
        <div>
          <div class="card-label">${m.label}</div>
          <div class="card-title">${m.title}</div>
        </div>
      </div>
      <div class="card-body">
        <div class="section-block">
          <div class="section-label">Mogelijke oorzaken</div>
          <p class="section-text">${d.oorzaken || '—'}</p>
        </div>
        <div class="section-block">
          <div class="section-label">Aandachtspunten onderzoek</div>
          <p class="section-text">${d.aandachtspunten || '—'}</p>
        </div>
        ${tagsHtml ? `<div class="section-block">
          <div class="section-label">Structuren & gebieden</div>
          <div class="tags-row">${tagsHtml}</div>
        </div>` : ''}
      </div>
    `;
    grid.appendChild(card);
  });

  document.getElementById('resultsSection').style.display = 'block';
  document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function resetSearch() {
  document.getElementById('resultsSection').style.display = 'none';
  document.getElementById('queryInput').value = '';
  document.getElementById('queryInput').style.height = 'auto';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>
